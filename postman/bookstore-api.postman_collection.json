{
  "info": {
    "name": "Django Bookstore REST API",
    "description": "Postman tests for Django Bookstore REST API exam project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API Root",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://127.0.0.1:8000/api/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"API root is reachable\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Authors List",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://127.0.0.1:8000/api/authors/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "authors", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Authors list returns 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Authors response is an array\", function () {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Categories List",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://127.0.0.1:8000/api/categories/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "categories", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Categories list returns 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Category has required fields\", function () {",
              "    const data = pm.response.json();",
              "    if (data.length > 0) {",
              "        pm.expect(data[0]).to.have.property(\"name\");",
              "        pm.expect(data[0]).to.have.property(\"is_active\");",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Books List",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://127.0.0.1:8000/api/books/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "books", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Books list returns 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Book contains computed fields\", function () {",
              "    const data = pm.response.json();",
              "    if (data.length > 0) {",
              "        pm.expect(data[0]).to.have.property(\"author_first_name\");",
              "        pm.expect(data[0]).to.have.property(\"category_name\");",
              "        pm.expect(data[0]).to.have.property(\"is_available\");",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Book Detail (Valid ID)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://127.0.0.1:8000/api/books/1/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "books", "1", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Book detail returns 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Book detail has title and price\", function () {",
              "    const book = pm.response.json();",
              "    pm.expect(book).to.have.property(\"title\");",
              "    pm.expect(book).to.have.property(\"price\");",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
